# Required: Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional service registry (calmlib). Localhost only — never a prod host.
#CALMMAGE_SERVICE_REGISTRY_URL=http://localhost:8765

# ----------------------------------------
# Botspot Components
# Every key uses the component env prefix from BotspotSettings.
# ----------------------------------------

# Access lists (usernames or numeric telegram ids — placeholders only)
BOTSPOT_ADMINS_STR="@username"
#BOTSPOT_FRIENDS_STR="@friend"

# Event Scheduler
#BOTSPOT_SCHEDULER_ENABLED=true
#BOTSPOT_SCHEDULER_TIMEZONE=UTC

# MongoDB (needed for user_data, access_control, subscription_manager, queues, chat_binder)
#BOTSPOT_MONGO_DATABASE_ENABLED=true
#BOTSPOT_MONGO_DATABASE_CONN_STR=mongodb://localhost:27017
#BOTSPOT_MONGO_DATABASE_DATABASE=dev-project-name

# PostgreSQL (preferred for new bots; use Alembic in the app for migrations)
#BOTSPOT_POSTGRES_DATABASE_ENABLED=true
#BOTSPOT_POSTGRES_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname

# Telethon Manager
#BOTSPOT_TELETHON_MANAGER_ENABLED=true
#BOTSPOT_TELETHON_MANAGER_API_ID=
#BOTSPOT_TELETHON_MANAGER_API_HASH=
#BOTSPOT_TELETHON_MANAGER_SESSIONS_DIR=sessions
#BOTSPOT_TELETHON_MANAGER_AUTO_AUTH=true

# Trial Mode (legacy per-handler caps; subscription_manager has its own trial)
#BOTSPOT_TRIAL_MODE_ENABLED=true
#BOTSPOT_TRIAL_MODE_PERIOD_PER_USER=86400
#BOTSPOT_TRIAL_MODE_GLOBAL_PERIOD=86400
#BOTSPOT_TRIAL_MODE_ALLOWED_USERS=["username1", "username2"]
#BOTSPOT_TRIAL_MODE_LIMIT_PER_USER=10
#BOTSPOT_TRIAL_MODE_GLOBAL_LIMIT=100

# User Data
#BOTSPOT_USER_DATA_ENABLED=true
#BOTSPOT_USER_DATA_MIDDLEWARE_ENABLED=true
#BOTSPOT_USER_DATA_COLLECTION=botspot_users
#BOTSPOT_USER_DATA_CACHE_TTL=300

# Access Control (persistent friends/admins in Mongo; /add_friend, /list_friends)
#BOTSPOT_ACCESS_CONTROL_ENABLED=true
#BOTSPOT_ACCESS_CONTROL_MONGO_COLLECTION=access_control
#BOTSPOT_ACCESS_CONTROL_COMMANDS_VISIBLE=false

# Single User Mode
BOTSPOT_SINGLE_USER_MODE_ENABLED=false
#BOTSPOT_SINGLE_USER_MODE_USER=

# Send Safe
BOTSPOT_SEND_SAFE_ENABLED=true
#BOTSPOT_SEND_SAFE_WRAP_TEXT=false
#BOTSPOT_SEND_SAFE_SEND_LONG_MESSAGES_AS_FILES=true
#BOTSPOT_SEND_SAFE_SEND_PREVIEW_FOR_LONG_MESSAGES=false
#BOTSPOT_SEND_SAFE_PREVIEW_CUTOFF=200
#BOTSPOT_SEND_SAFE_WRAP_WIDTH=88
#BOTSPOT_SEND_SAFE_PARSE_MODE=HTML
#BOTSPOT_SEND_SAFE_AUTO_DELETE_ENABLED=
#BOTSPOT_SEND_SAFE_AUTO_DELETE_TIMEOUT=300

# Admin Filter
#BOTSPOT_ADMIN_FILTER_NOTIFY_BLOCKED=true

# Chat Binder
#BOTSPOT_CHAT_BINDER_ENABLED=false
#BOTSPOT_CHAT_BINDER_MONGO_COLLECTION=chat_binder
#BOTSPOT_CHAT_BINDER_COMMANDS_VISIBLE=false
#BOTSPOT_CHAT_BINDER_REBIND_MODE=error
#BOTSPOT_CHAT_BINDER_CHECK_ACCESS=true

# Chat Fetcher
#BOTSPOT_CHAT_FETCHER_ENABLED=false
#BOTSPOT_CHAT_FETCHER_DB_CACHE_ENABLED=false
#BOTSPOT_CHAT_FETCHER_DEFAULT_DIALOGS_LIMIT=

# LLM Provider (needed for /ask). Keys are read from the process env.
BOTSPOT_LLM_PROVIDER_ENABLED=true
#BOTSPOT_LLM_PROVIDER_DEFAULT_MODEL=claude-4
#BOTSPOT_LLM_PROVIDER_DEFAULT_TEMPERATURE=0.7
#BOTSPOT_LLM_PROVIDER_DEFAULT_MAX_TOKENS=1024
#BOTSPOT_LLM_PROVIDER_DEFAULT_TIMEOUT=90
#BOTSPOT_LLM_PROVIDER_ALLOW_EVERYONE=false
#BOTSPOT_LLM_PROVIDER_SKIP_IMPORT_CHECK=false
#BOTSPOT_LLM_PROVIDER_DROP_UNSUPPORTED_PARAMS=true
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#GOOGLE_API_KEY=
#XAI_API_KEY=
#DEEPSEEK_API_KEY=
#OPENROUTER_API_KEY=
#MISTRAL_API_KEY=
#PERPLEXITY_API_KEY=
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_ENDPOINT=

# Queue Manager
#BOTSPOT_QUEUE_MANAGER_ENABLED=false
#BOTSPOT_QUEUE_MANAGER_COLLECTION_NAME_PREFIX=botspot_queue_

# Message Aggregator (debounce bursts / albums)
#BOTSPOT_MESSAGE_AGGREGATOR_ENABLED=false
#BOTSPOT_MESSAGE_AGGREGATOR_DELAY=1.0
#BOTSPOT_MESSAGE_AGGREGATOR_IGNORE_COMMANDS=true

# Auto Archive
#BOTSPOT_AUTO_ARCHIVE_ENABLED=false
#BOTSPOT_AUTO_ARCHIVE_DELAY=10
#BOTSPOT_AUTO_ARCHIVE_ENABLE_CHAT_HANDLER=false
#BOTSPOT_AUTO_ARCHIVE_PRIVATE_CHATS_ONLY=true
#BOTSPOT_AUTO_ARCHIVE_CHAT_BINDING_KEY=default
#BOTSPOT_AUTO_ARCHIVE_BIND_COMMAND_VISIBLE=true
#BOTSPOT_AUTO_ARCHIVE_NO_ARCHIVE_TAG=#noarchive
#BOTSPOT_AUTO_ARCHIVE_NO_DELETE_TAG=#nodelete
#BOTSPOT_AUTO_ARCHIVE_FORWARD_SENT_MESSAGES=true
#BOTSPOT_AUTO_ARCHIVE_DONT_FORWARD_COMMANDS=true
#BOTSPOT_AUTO_ARCHIVE_COMMAND_FILTER_MODE=pure_commands

# S3 Storage
#BOTSPOT_S3_STORAGE_ENABLED=false
#BOTSPOT_S3_STORAGE_BUCKET_NAME=
#BOTSPOT_S3_STORAGE_REGION=
#BOTSPOT_S3_STORAGE_ACCESS_KEY_ID=
#BOTSPOT_S3_STORAGE_SECRET_ACCESS_KEY=
#BOTSPOT_S3_STORAGE_SKIP_IMPORT_CHECK=false

# i18n (en/ru from Telegram language_code; register_strings in src/i18n.py)
#BOTSPOT_I18N_ENABLED=true
#BOTSPOT_I18N_DEFAULT_LOCALE=en

# Subscription Manager (credits + Stars subscriptions + trial caps)
# Requires MongoDB. Friends/admins bypass via BOTSPOT_FRIENDS_STR / BOTSPOT_ADMINS_STR.
#BOTSPOT_SUBSCRIPTION_MANAGER_ENABLED=false
#BOTSPOT_SUBSCRIPTION_MANAGER_REGISTER_COMMANDS=true
#BOTSPOT_SUBSCRIPTION_MANAGER_COLLECTION_PREFIX=billing_
#BOTSPOT_SUBSCRIPTION_MANAGER_CREDITS_PER_USD=100
#BOTSPOT_SUBSCRIPTION_MANAGER_STARS_PER_USD=100
#BOTSPOT_SUBSCRIPTION_MANAGER_MEDIA_COST_MULTIPLIER=1.6
#BOTSPOT_SUBSCRIPTION_MANAGER_CHAT_COST_MULTIPLIER=1.2
#BOTSPOT_SUBSCRIPTION_MANAGER_GRACE_DAYS=2
#BOTSPOT_SUBSCRIPTION_MANAGER_RECONCILE_INTERVAL_HOURS=6
#BOTSPOT_SUBSCRIPTION_MANAGER_SIGNATURE_SECRET=
#BOTSPOT_SUBSCRIPTION_MANAGER_PLANS_JSON=
#BOTSPOT_SUBSCRIPTION_MANAGER_PACKS_JSON=
#BOTSPOT_SUBSCRIPTION_MANAGER_PUBLIC_BASE_URL=https://example.com
#BOTSPOT_SUBSCRIPTION_MANAGER_STRIPE_SECRET_KEY=
#BOTSPOT_SUBSCRIPTION_MANAGER_STRIPE_WEBHOOK_SECRET=
#BOTSPOT_SUBSCRIPTION_MANAGER_STRIPE_ALLOW_LIVE=false
#BOTSPOT_SUBSCRIPTION_MANAGER_STRIPE_PRICE_IDS_JSON=
#BOTSPOT_SUBSCRIPTION_MANAGER_YOOKASSA_SHOP_ID=
#BOTSPOT_SUBSCRIPTION_MANAGER_YOOKASSA_SECRET_KEY=
#BOTSPOT_SUBSCRIPTION_MANAGER_YOOKASSA_RETURN_URL=
#BOTSPOT_SUBSCRIPTION_MANAGER_YOOKASSA_USD_RATE=0
#BOTSPOT_SUBSCRIPTION_MANAGER_TON_WALLET_ADDRESS=
#BOTSPOT_SUBSCRIPTION_MANAGER_TON_USD_RATE=0
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_ENABLED=true
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_DURATION_DAYS=7
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_USER_AUDIO_REQUESTS_TOTAL=20
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_USER_AUDIO_MINUTES_TOTAL=90.0
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_USER_CHAT_REQUESTS_TOTAL=200
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_USER_CHAT_TOKENS_TOTAL=60000
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_GLOBAL_AUDIO_REQUESTS_PER_DAY=100
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_GLOBAL_AUDIO_MINUTES_PER_DAY=480.0
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_GLOBAL_CHAT_REQUESTS_PER_DAY=1000
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_GLOBAL_CHAT_TOKENS_PER_DAY=400000
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_GLOBAL_COST_USD_PER_DAY=2.0
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_DAILY_COST_ALERT_THRESHOLDS=0.5,1.0,1.5,2.0
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_UNKNOWN_MEDIA_MINUTES_DEFAULT=10.0
#BOTSPOT_SUBSCRIPTION_MANAGER_TRIAL_MEDIA_COST_PER_MINUTE_USD=0.006

# Commands Menu
#BOTSPOT_BOT_COMMANDS_MENU_ENABLED=true
#BOTSPOT_BOT_COMMANDS_MENU_ADMIN_ID=0
#BOTSPOT_BOT_COMMANDS_MENU_ADD_LIST_COMMANDS_HANDLER=true
#BOTSPOT_BOT_COMMANDS_MENU_GROUP_DISPLAY_MODE=NESTED
#BOTSPOT_BOT_COMMANDS_MENU_DEFAULT_GROUP=General
#BOTSPOT_BOT_COMMANDS_MENU_SORT_COMMANDS=true

# ----------------------------------------
# Enabled by default in botspot
# ----------------------------------------

#BOTSPOT_PRINT_BOT_URL_ENABLED=true
BOTSPOT_ERROR_HANDLER_ENABLED=true
BOTSPOT_ERROR_HANDLER_EASTER_EGGS=true
#BOTSPOT_ERROR_HANDLER_DEVELOPER_CHAT_ID=0
#BOTSPOT_BOT_INFO_ENABLED=true
#BOTSPOT_BOT_INFO_HIDE_COMMAND=false
#BOTSPOT_BOT_INFO_SHOW_DETAILED_SETTINGS=true
#BOTSPOT_ASK_USER_ENABLED=true
#BOTSPOT_ASK_USER_DEFAULT_TIMEOUT=1200
